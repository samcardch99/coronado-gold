---
import { Image } from "astro:assets";
import coverBgDesktop from "../assets/cover-bg-desktop.jpg";
import coverBgMobile from "../assets/cover-bg-mobile.jpg";
---

<section
    id="home"
    class="relative w-full h-screen overflow-hidden bg-linear-to-b from-[#CEC8C3] from-70% to-[#D8D0C7] flex items-end justify-center"
>
    <Image
        src={coverBgDesktop}
        alt="Coronado Gold fine jewelry collection — handcrafted gold rings and necklaces"
        class="hidden md:block absolute inset-0 object-cover object-center h-full w-full"
        quality={78}
        widths={[1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
    />
    <Image
        src={coverBgMobile}
        alt="Coronado Gold fine jewelry collection — handcrafted gold rings and necklaces"
        class="md:hidden absolute inset-0 object-cover object-center h-full w-full"
        quality={68}
        widths={[900, 1200, 1800]}
        sizes="150vw"
        loading="eager"
        fetchpriority="high"
    />
</section>
